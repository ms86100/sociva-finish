# Evolution Go - copy to .env on the VPS. Never commit real secrets.

# Server
SERVER_PORT=8080
CLIENT_NAME=sociva-evolution

# Security - generate a long random value for production
GLOBAL_API_KEY=change-me-to-a-long-random-secret

# PostgreSQL (matches docker-compose service name "postgres")
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_AUTH_DB=postgresql://postgres:change-me-strong-db-password@postgres:5432/evogo_auth?sslmode=disable
POSTGRES_USERS_DB=postgresql://postgres:change-me-strong-db-password@postgres:5432/evogo_users?sslmode=disable
DATABASE_SAVE_MESSAGES=false

# Logging
WADEBUG=INFO
LOGTYPE=json

# Reconnect WhatsApp sessions after container restart
CONNECT_ON_STARTUP=true
WEBHOOKFILES=true

# Optional Evolution-global webhook (prefer per-instance via Sociva Admin Connect)
# WEBHOOK_URL=http://webhook-relay:8787/

# Sociva Edge Function secrets (Supabase Dashboard / CLI - NOT this VPS .env):
# EVOLUTION_GO_BASE_URL=https://wa.your-domain.com
# EVOLUTION_GO_API_KEY=<same as GLOBAL_API_KEY>
# EVOLUTION_GO_WEBHOOK_SECRET=<long random shared secret>
# EVOLUTION_GO_INSTANCE_NAME=sociva-primary
# EVOLUTION_GO_WEBHOOK_URL=http://webhook-relay:8787/
#   ^ private Docker DNS name; relay injects x-sociva-webhook-secret (see docker-compose.relay.yml)
