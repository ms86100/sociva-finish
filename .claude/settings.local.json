{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8082",
    "ANTHROPIC_AUTH_TOKEN": "freecc"
  },
  "permissions": {
    "allow": [
      "Bash(xargs grep -l \"confirm_captured_payment_group\")",
      "Bash(xargs grep -l \"confirm_orders_after_razorpay_payment\")",
      "Bash(xargs grep -l -i \"razorpay.*webhook\\\\|webhook.*razorpay\")",
      "Bash(xargs grep -l \"record_payment_attempt_failure\")",
      "Bash(xargs grep -l \"PaymentConfirmingBanner\")",
      "Bash(xargs grep -l \"verify_seller_payment\")",
      "Bash(xargs grep -l -i \"android\\\\|capacitor\")",
      "Bash(npm --version)",
      "Bash(npm run *)",
      "Bash(npx cap *)",
      "Bash(./gradlew assembleRelease)",
      "Bash(xargs grep -l \"razorpay\\\\|upi\\\\|payment\")",
      "Bash(git commit -m 'fix: eliminate Deep UPI cancel loop, fix UPI web popup, expose raw COD error *)",
      "Bash(git commit -m 'chore: bump Android APK to v2.0.22 with payment fixes *)",
      "mcp__supabase__execute_sql",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_projects",
      "mcp__supabase__get_edge_function",
      "Bash(vercel *)",
      "Bash(npm i *)",
      "Bash(xargs grep -l \"@/types/database\")",
      "Bash(xargs sed -i 's|@/types/database|@/types/Database|g')",
      "Bash(git commit *)",
      "Bash(sort -k5 -nr)",
      "Bash(npx tsc *)",
      "Bash(rtk git *)",
      "Bash(rtk tsc *)",
      "Bash(rtk grep *)",
      "Bash(dir /b /s)",
      "Bash(rtk ls *)",
      "mcp__supabase__apply_migration",
      "Bash(npx vitest *)",
      "Bash(supabase db *)",
      "Bash(rtk npx *)",
      "Bash(npx supabase *)",
      "Bash(rtk read *)",
      "mcp__supabase__get_project"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "supabase"
  ]
}
